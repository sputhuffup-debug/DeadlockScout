<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only. <clear/> drops any feed a machine-wide or user NuGet.Config adds, and the
     source mapping makes every package id resolve from nuget.org, so a same-named package on another feed can never be
     picked up (dependency confusion). The lock files pin the exact versions and content hashes on top of this. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
