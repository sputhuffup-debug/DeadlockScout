# Build output
bin/
obj/
*.user
*.suo
.vs/
.idea/
TestResults/
artifacts/
publish/

# Local app data never belongs in the repo
settings.json
cache.db*

# Replays and broadcasts carry every player's name and account id
*.dem
*.dem.bz2

# Real game logs may carry account ids; fixtures are scrubbed copies under tests/Fixtures
console.log
content_log.txt
# The app's own log files (account ids, player names); they live in %LOCALAPPDATA%, never here
scout-*.log
scout-log.txt

# Synthetic test fixtures are always committed, whatever their names
!tests/**/Fixtures/**
