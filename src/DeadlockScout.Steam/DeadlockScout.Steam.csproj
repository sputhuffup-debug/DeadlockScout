<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DeadlockScout.Steam</RootNamespace>
    <Description>Reads what the game and Steam write on purpose: console.log, content_log.txt, loginusers.vdf, the registry. Never touches the game process.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeadlockScout.Core\DeadlockScout.Core.csproj" />
  </ItemGroup>

</Project>
