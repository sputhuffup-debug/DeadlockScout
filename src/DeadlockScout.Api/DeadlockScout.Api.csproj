  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DeadlockScout.Api</RootNamespace>
    <Description>deadlock-api.com client, rate limiting, two-layer cache, live feed and benchmark providers. The only project that holds an HttpClient.</Description>
  </PropertyGroup>

  <ItemGroup>
