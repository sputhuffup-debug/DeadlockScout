<Window x:Class="DeadlockScout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeadlockScout.App.ViewModels"
        Title="DeadlockScout" Width="900" Height="640" Background="#1A1F24" Foreground="#F0F0F0">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <DataTemplate x:Key="Row" DataType="{x:Type vm:ScoutRowViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Hero}" Foreground="#A0B0B8"/>
                <TextBlock Grid.Column="2" Text="{Binding GamesOnHero}"/>
                <TextBlock Grid.Column="3" Text="{Binding WinRate}"/>
                <TextBlock Grid.Column="4" Text="{Binding Rank}" Foreground="#A0B0B8"/>
                <TextBlock Grid.Column="5" Text="{Binding Met}" Foreground="#A0B0B8"/>
                <TextBlock Grid.Column="6" Text="{Binding Flag}" Foreground="#F2B134"/>
                <TextBlock Grid.Column="7" Text="{Binding Matchup}" Foreground="#A0B0B8"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="12">
        <StackPanel x:Name="Header" DockPanel.Dock="Top">
            <TextBlock Text="DeadlockScout" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding Status.Phase}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Status.Detection}" Foreground="#A0B0B8" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Status.Warning}" Foreground="#F2B134" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
                <Button Content="Toggle overlay" Click="ToggleOverlay" Padding="8,2" Margin="0,0,8,0"/>
                <Button Content="Open settings.json" Click="OpenSettings" Padding="8,2" Margin="0,0,8,0"/>
                <Button Content="Add -condebug" Click="AddCondebug" Padding="8,2" Margin="0,0,8,0"/>
                <Button Content="Calibrate OCR regions" Click="CalibrateOcr" Padding="8,2" Margin="0,0,8,0"
                        ToolTip="Draw boxes over your soul count, the clock and the enemy scoreboard souls. Only those boxes are captured."/>
                <Button Content="Show demo lobby" Click="ShowDemo" Padding="8,2" Margin="0,0,8,0"/>
                <Button x:Name="PreviewButton" Content="Preview overlay" Click="PreviewOverlay" Padding="8,2"
                        ToolTip="Show the overlay now, outside a match and without the game in front (over your primary screen if the game is not running). Loads the demo lobby when no match is live."/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Live feed:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="DirectSource" GroupName="LiveSource" Content="Direct" Foreground="#F0F0F0" VerticalAlignment="Center" Margin="0,0,12,0" Checked="LiveSourceChecked"
                             ToolTip="The app reads Valve's broadcast itself. Falls back to Hosted for a match it cannot parse."/>
                <RadioButton x:Name="HostedSource" GroupName="LiveSource" Content="Hosted" Foreground="#F0F0F0" VerticalAlignment="Center" Margin="0,0,12,0" Checked="LiveSourceChecked"
                             ToolTip="deadlock-api.com's hosted live query over the broadcast."/>
                <TextBlock x:Name="LiveSourceNote" Foreground="#A0B0B8" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer>
            <StackPanel x:Name="Body">
                <StackPanel Margin="0,0,0,8" Visibility="{Binding Session.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                    <TextBlock Text="{Binding Session.Today}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Session.Nudge}" Foreground="#F2B134" TextWrapping="Wrap"
                               Visibility="{Binding Session.Nudge, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding Session.HeroPool}" Foreground="#A0B0B8" TextWrapping="Wrap"
                               Visibility="{Binding Session.HeroPool, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                </StackPanel>
                <Border Background="#B0101418" CornerRadius="4" Padding="8,4" Margin="0,0,0,8"
                        Visibility="{Binding LastMatch.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                    <StackPanel>
                        <TextBlock Text="Last match" FontSize="11" Foreground="#A0B0B8"/>
                        <TextBlock Text="{Binding LastMatch.Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding LastMatch.Pace}" TextWrapping="Wrap"
                                   Visibility="{Binding LastMatch.Pace, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                        <TextBlock Text="{Binding LastMatch.Lane}" TextWrapping="Wrap"
                                   Visibility="{Binding LastMatch.Lane, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                        <TextBlock Text="{Binding LastMatch.Footer}" FontSize="11" Foreground="#A0B0B8" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Background="#B0101418" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="{Binding Pace.Line}" FontSize="16" FontWeight="SemiBold" Foreground="{Binding Pace.Delta, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                        <Canvas Width="240" Height="26" Margin="0,2,0,0" HorizontalAlignment="Left" x:Name="MainSparkline"
                                Visibility="{Binding Pace.HasSparkline, Converter={x:Static vm:Converters.VisibleIfTrue}}"
                                ToolTip="Your pace against the curve over the last ten minutes; the middle line is on pace, the edges ±25%">
                            <Line X1="0" Y1="13" X2="240" Y2="13" Stroke="#506A7880" StrokeThickness="1" StrokeDashArray="3 3"/>
                            <Polyline Points="{Binding Pace.Sparkline}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                      Stroke="{Binding Pace.Delta, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                        </Canvas>
                        <TextBlock Text="{Binding Pace.PersonalLine}" FontSize="13" Foreground="{Binding Pace.PersonalDelta, Converter={x:Static vm:Converters.DeltaBrush}}"
                                   Visibility="{Binding Pace.PersonalLine, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                        <TextBlock Text="{Binding Pace.Tooltip}" FontSize="11" Foreground="#A0B0B8"/>
                    </StackPanel>
                </Border>
                <StackPanel Margin="0,0,0,8" Visibility="{Binding Build.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                    <TextBlock Text="{Binding Build.Title}" Foreground="#A0B0B8"/>
                    <TextBlock Text="{Binding Build.Items}"/>
                    <TextBlock Text="{Binding Build.Abilities}"/>
                </StackPanel>
                <TextBlock Text="{Binding Scout.RankSpread}" Foreground="#A0B0B8"/>
                <TextBlock Text="{Binding Scout.LaneTitle}" Foreground="#A0B0B8" Margin="0,6,0,0"
                           Visibility="{Binding Scout.LaneOpponents.Count, Converter={x:Static vm:Converters.VisibleIfPositive}}"/>
                <ItemsControl ItemsSource="{Binding Scout.LaneOpponents}" ItemTemplate="{StaticResource Row}"/>
                <TextBlock Text="Amber" Foreground="#F2B134" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding Scout.Amber}" ItemTemplate="{StaticResource Row}"/>
                <TextBlock Text="Sapphire" Foreground="#5FA8F5" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <ItemsControl ItemsSource="{Binding Scout.Sapphire}" ItemTemplate="{StaticResource Row}"/>
                <TextBlock Text="Enemy pace" Foreground="#A0B0B8" Margin="0,10,0,0"/>
                <ItemsControl ItemsSource="{Binding EnemyPace.Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EnemyPaceRowViewModel}">
                            <TextBlock Text="{Binding Line}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
