<Window x:Class="DeadlockScout.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeadlockScout.App.ViewModels"
        Title="DeadlockScout" Icon="pack://application:,,,/Assets/app.ico" Width="900" Height="680"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI">
    <!-- Colours, cards, captions, chips and the flat buttons come from Themes/Theme.xaml. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- Lobby table columns, shared by the header row and every player row -->
        <Style x:Key="LobbyGrid" TargetType="Grid">
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <DataTemplate x:Key="TeamHeader">
            <StackPanel Orientation="Horizontal" Margin="0,8,0,2">
                <Border Width="3" Height="14" CornerRadius="1" Background="{Binding Brush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontWeight="SemiBold"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="Row" DataType="{x:Type vm:ScoutRowViewModel}">
            <Border CornerRadius="3" Padding="4,1" Background="{Binding IsMe, Converter={x:Static vm:Converters.MeRowBrush}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="136"/>
                        <ColumnDefinition Width="106"/>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="106"/>
                        <ColumnDefinition Width="52"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{Binding IsMe, Converter={x:Static vm:Converters.BoldIfTrue}}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Hero}" Foreground="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="2" Text="{Binding GamesOnHero}"/>
                    <TextBlock Grid.Column="3" Text="{Binding WinRate}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Rank}" Foreground="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Met}" Foreground="{StaticResource Muted}"/>
                    <Border Grid.Column="6" Style="{StaticResource Chip}" Visibility="{Binding Flag, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}">
                        <TextBlock Text="{Binding Flag}" Foreground="{StaticResource Amber}" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                    <TextBlock Grid.Column="7" Text="{Binding Matchup}" Foreground="{StaticResource Gold}" FontWeight="SemiBold"/>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="EnemyRow" DataType="{x:Type vm:EnemyPaceRowViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Hero}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding NetWorthText}" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="{Binding DeltaText}" FontWeight="SemiBold" HorizontalAlignment="Right"
                           Foreground="{Binding Lead, Converter={x:Static vm:Converters.LeadBrush}}"/>
                <Border Grid.Column="3" Height="5" CornerRadius="2" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Width="{Binding Lead, Converter={x:Static vm:Converters.LeadBar}}"
                        Background="{Binding Lead, Converter={x:Static vm:Converters.LeadBrush}}"/>
                <!-- Their latest power-spike item, as on the overlay (Themes/Theme.xaml) -->
                <ContentPresenter Grid.Column="4" Content="{Binding}" ContentTemplate="{StaticResource SpikeChip}" VerticalAlignment="Center"
                                  Visibility="{Binding SpikeText, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="16,12">
        <StackPanel x:Name="Header" DockPanel.Dock="Top">
            <!-- App name, and what it is doing right now -->
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="32" Height="32" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,10,0"/>
                    <TextBlock Text="DeadlockScout" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Style="{StaticResource Pill}" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Status.Phase}"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="SETUP" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding Status.Detection}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" LineHeight="18"/>
                    <TextBlock Text="{Binding Status.Warning}" Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,4,0,0"
                               Visibility="{Binding Status.Warning, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                </StackPanel>
            </Border>
            <WrapPanel Margin="0,0,0,2">
                <Button x:Name="PreviewButton" Content="Preview overlay" Click="PreviewOverlay" Style="{StaticResource AccentButton}"
                        ToolTip="Show the overlay now, outside a match and without the game in front (over your primary screen if the game is not running). Loads the demo lobby when no match is live. While it is on you can drag the panels where you want them."/>
                <Button Content="Match history" Click="MatchHistory"
                        ToolTip="Your recent games: rank, win rate, KDA, and each game's soul timeline and item purchases."/>
                <Button Content="Toggle overlay" Click="ToggleOverlay"/>
                <Button Content="{Binding Status.DemoButton}" Click="ShowDemo"
                        ToolTip="Fill the panels with a made-up lobby to check the layout. Click again to put your own data back; during a match it catches up with the live feed."/>
                <Button Content="Calibrate OCR regions" Click="CalibrateOcr"
                        ToolTip="Draw boxes over your soul count, the clock and the enemy scoreboard souls. Only those boxes are captured."/>
                <Button Content="Add -condebug" Click="AddCondebug"/>
                <Button Content="Open settings.json" Click="OpenSettings"/>
                <Button Content="Exit" Click="ExitApp"
                        ToolTip="Quit DeadlockScout. Closing this window only hides it; the app keeps running in the tray."/>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <TextBlock Text="Live feed" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <RadioButton x:Name="DirectSource" GroupName="LiveSource" Content="Direct" Checked="LiveSourceChecked"
                             ToolTip="The app reads Valve's broadcast itself. Falls back to Hosted for a match it cannot parse."/>
                <RadioButton x:Name="HostedSource" GroupName="LiveSource" Content="Hosted" Checked="LiveSourceChecked"
                             ToolTip="deadlock-api.com's hosted live query over the broadcast."/>
                <TextBlock x:Name="LiveSourceNote" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body">
                <!-- Today -->
                <Border Style="{StaticResource Card}" Visibility="{Binding Session.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                    <StackPanel>
                        <TextBlock Text="TODAY" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Session.Today}" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Session.Nudge}" Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding Session.Nudge, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                        <TextBlock Text="{Binding Session.HeroPool}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Visibility="{Binding Session.HeroPool, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    </StackPanel>
                </Border>
                <!-- Last match, with a green or red edge for the result -->
                <Border Style="{StaticResource Card}" Padding="0" Visibility="{Binding LastMatch.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Width="4" CornerRadius="8,0,0,8" Background="{Binding LastMatch.Won, Converter={x:Static vm:Converters.OutcomeBrush}}"/>
                        <StackPanel Margin="12,8">
                            <TextBlock Text="LAST MATCH" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding LastMatch.Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding LastMatch.Pace}" TextWrapping="Wrap" Margin="0,2,0,0"
                                       Visibility="{Binding LastMatch.Pace, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                            <TextBlock Text="{Binding LastMatch.Lane}" TextWrapping="Wrap"
                                       Visibility="{Binding LastMatch.Lane, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                            <TextBlock Text="{Binding LastMatch.Footer}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Live pace: the same scoreboard as the overlay -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="PACE" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding Pace.Hero}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="10,0,0,0"/>
                            <TextBlock Text="{Binding Pace.Clock}" FontSize="11" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding Pace.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                            <TextBlock Text="{Binding Pace.DeltaText}" FontSize="34" FontWeight="Bold" VerticalAlignment="Center" MinWidth="86"
                                       Foreground="{Binding Pace.Delta, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,18,0">
                                <TextBlock Text="{Binding Pace.Spm}" FontSize="15" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Pace.Target}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                    <TextBlock Text="{Binding Pace.Percentile}" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Canvas Width="240" Height="26" VerticalAlignment="Center" x:Name="MainSparkline"
                                    Visibility="{Binding Pace.HasSparkline, Converter={x:Static vm:Converters.VisibleIfTrue}}"
                                    ToolTip="Your pace against the curve over the last ten minutes; the middle line is on pace, the edges ±25%">
                                <Line X1="0" Y1="13" X2="240" Y2="13" Stroke="#506A7880" StrokeThickness="1" StrokeDashArray="3 3"/>
                                <Polyline Points="{Binding Pace.Sparkline}" StrokeThickness="2" StrokeLineJoin="Round"
                                          Stroke="{Binding Pace.Delta, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                            </Canvas>
                        </StackPanel>
                        <TextBlock Text="No match yet: the pace shows here and on the overlay once a match is live." Foreground="{StaticResource Muted}"
                                   Visibility="{Binding Pace.HasData, Converter={x:Static vm:Converters.CollapsedIfTrue}}"/>
                        <TextBlock Text="{Binding Pace.PersonalLine}" Margin="0,2,0,0" Foreground="{Binding Pace.PersonalDelta, Converter={x:Static vm:Converters.DeltaBrush}}"
                                   Visibility="{Binding Pace.PersonalLine, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                        <TextBlock Text="{Binding Pace.Tooltip}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                                   Visibility="{Binding Pace.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}"/>
                    </StackPanel>
                </Border>
                <!-- Build hint -->
                <Border Style="{StaticResource Card}" Visibility="{Binding Build.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Build.Title}" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Build.Items}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Build.Abilities}" Foreground="{StaticResource Gold}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Lobby -->
                <Border Style="{StaticResource Card}" Visibility="{Binding Scout.Amber.Count, Converter={x:Static vm:Converters.VisibleIfPositive}}">
                    <StackPanel>
                        <TextBlock Text="LOBBY" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Scout.RankSpread}" Foreground="{StaticResource Muted}"/>
                        <StackPanel Visibility="{Binding Scout.LaneOpponents.Count, Converter={x:Static vm:Converters.VisibleIfPositive}}">
                            <TextBlock Text="{Binding Scout.LaneTitle}" FontWeight="SemiBold" Foreground="{StaticResource Gold}" Margin="0,8,0,2"/>
                            <ItemsControl ItemsSource="{Binding Scout.LaneOpponents}" ItemTemplate="{StaticResource Row}"/>
                        </StackPanel>
                        <!-- Column headings, on the same columns as the rows -->
                        <Grid Margin="4,10,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="136"/>
                                <ColumnDefinition Width="106"/>
                                <ColumnDefinition Width="132"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="106"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PLAYER" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="1" Text="HERO" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="2" Text="ON HERO / TOTAL" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="3" Text="WIN" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="4" Text="RANK" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="5" Text="MET" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="6" Text="FLAG" Style="{StaticResource Caption}"/>
                        </Grid>
                        <ContentPresenter ContentTemplate="{StaticResource TeamHeader}" Content="{x:Static vm:TeamHeaders.Amber}"/>
                        <ItemsControl ItemsSource="{Binding Scout.Amber}" ItemTemplate="{StaticResource Row}"/>
                        <ContentPresenter ContentTemplate="{StaticResource TeamHeader}" Content="{x:Static vm:TeamHeaders.Sapphire}"/>
                        <ItemsControl ItemsSource="{Binding Scout.Sapphire}" ItemTemplate="{StaticResource Row}"/>
                    </StackPanel>
                </Border>
                <!-- Enemy pace (every player while spectating) -->
                <Border Style="{StaticResource Card}" Visibility="{Binding EnemyPace.Rows.Count, Converter={x:Static vm:Converters.VisibleIfPositive}}">
                    <StackPanel>
                        <TextBlock Text="{Binding EnemyPace.Title}" Style="{StaticResource Caption}"/>
                        <ItemsControl ItemsSource="{Binding EnemyPace.Rows}" ItemTemplate="{StaticResource EnemyRow}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
