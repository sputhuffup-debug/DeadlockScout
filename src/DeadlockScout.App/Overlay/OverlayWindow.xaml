<Window x:Class="DeadlockScout.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeadlockScout.App.ViewModels"
        Title="DeadlockScout overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False"
        Foreground="#F0F0F0" FontFamily="Segoe UI">
    <!-- Foreground and font on the window itself: the implicit TextBlock style below does not reach TextBlocks inside
         data templates, which would otherwise inherit the system's black text. -->
    <Window.Resources>
        <!-- Colours, the Panel card, Caption and Chip come from Themes/Theme.xaml. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <!-- A team heading with its colour bar -->
        <DataTemplate x:Key="TeamHeader">
            <StackPanel Orientation="Horizontal" Margin="0,4,0,2">
                <Border Width="3" Height="13" CornerRadius="1" Background="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Foreground="{Binding Brush}" FontWeight="SemiBold" FontSize="13"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="ScoutRow" DataType="{x:Type vm:ScoutRowViewModel}">
            <Border CornerRadius="3" Padding="4,1" Background="{Binding IsMe, Converter={x:Static vm:Converters.MeRowBrush}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="106"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="44"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{Binding IsMe, Converter={x:Static vm:Converters.BoldIfTrue}}"/>
                    <Border Grid.Column="1" CornerRadius="3" Padding="5,0" Margin="0,1,6,1" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{Binding Party, Converter={x:Static vm:Converters.PartyFill}}"
                            Visibility="{Binding PartyLabel, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"
                            ToolTip="Likely queued together: these players have partied before (public match records), and they are on the same team now">
                        <TextBlock Text="{Binding PartyLabel}" Foreground="{Binding Party, Converter={x:Static vm:Converters.PartyBrush}}" FontWeight="SemiBold" FontSize="11.5"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Lane}" Foreground="{StaticResource Muted}" ToolTip="The lane they start in"/>
                    <TextBlock Grid.Column="3" Text="{Binding Hero}" Foreground="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="4" Text="{Binding GamesOnHero}"/>
                    <TextBlock Grid.Column="5" Text="{Binding WinRate}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="6" Text="{Binding Rank}" Foreground="{StaticResource Muted}"/>
                    <TextBlock Grid.Column="7" Text="{Binding Met}" Foreground="{StaticResource Muted}"/>
                    <Border Grid.Column="8" Style="{StaticResource Chip}" Visibility="{Binding Flag, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}">
                        <TextBlock Text="{Binding Flag}" Foreground="{StaticResource Amber}" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- The lane card: no party tag, met-before or flag (the scout list has those), your matchup win rate instead. -->
        <DataTemplate x:Key="LaneRow" DataType="{x:Type vm:ScoutRowViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="106"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Hero}" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="2" Text="{Binding GamesOnHero}"/>
                <TextBlock Grid.Column="3" Text="{Binding WinRate}" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                <TextBlock Grid.Column="4" Text="{Binding Rank}" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="5" Text="{Binding Matchup}" Foreground="{StaticResource Gold}" FontWeight="SemiBold"
                           ToolTip="Your hero's lane win rate against this hero at your rank, and how many lane matchups that rests on"/>
            </Grid>
        </DataTemplate>
        <!-- One enemy (or, spectating, one player): hero, net worth, how far off the curve, and a bar for it. -->
        <DataTemplate x:Key="EnemyRow" DataType="{x:Type vm:EnemyPaceRowViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="62"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Hero}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                <TextBlock Grid.Column="1" Text="{Binding NetWorthText}" FontSize="13" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="2" Text="{Binding DeltaText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"
                           Foreground="{Binding Lead, Converter={x:Static vm:Converters.LeadBrush}}"/>
                <Border Grid.Column="3" Height="5" CornerRadius="2" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Width="{Binding Lead, Converter={x:Static vm:Converters.LeadBar}}"
                        Background="{Binding Lead, Converter={x:Static vm:Converters.LeadBrush}}"/>
                <!-- Their latest power-spike item (Themes/Theme.xaml) -->
                <ContentPresenter Grid.Row="1" Grid.ColumnSpan="4" Margin="10,1,0,2" Content="{Binding}" ContentTemplate="{StaticResource SpikeChip}"
                                  HorizontalAlignment="Left" Visibility="{Binding SpikeText, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!--
      Placement follows the game's HUD on a 1920x1080 reference (the window scales it to the game's height):
      portraits, timer and team souls across the top (x 336-1584, y 0-155); spectator controls and the death recap on
      the right (x 1570+, y 0-500); stats, souls and items bottom left (from y 580); abilities bottom centre (x 770-1150,
      from y 865); minimap bottom right (x 1510-1890, from y 635). Panels stack in the free space so they never overlap
      the HUD or each other: the pace strip centred under the top bar, a left column between the top bar and the stats,
      and a narrow column between the pace strip and the spectator panel. The right edge and the bottom stay clear.
    -->
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- Centre, under the portraits: the pace strip as a scoreboard, and the status pill while there is no pace yet -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,168,0,0">
            <Border x:Name="PacePanel" Style="{StaticResource Panel}" MinWidth="460" Padding="14,8"
                    Visibility="{Binding Pace.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                <StackPanel>
                    <!-- Hero and game clock on the left, benchmark and source on the right -->
                    <Grid Margin="0,0,0,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Pace.Hero}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/>
                            <TextBlock Text="{Binding Pace.Clock}" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,0,0">
                            <TextBlock Text="{Binding Pace.Provider}" FontSize="11" Foreground="{StaticResource Muted}" ToolTip="{Binding Pace.Tooltip}"/>
                            <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding Pace.SourceLabel}" FontSize="11" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Grid>
                    <!-- The number that matters, big; the figures behind it beside it; the last ten minutes after -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Pace.DeltaText}" FontSize="34" FontWeight="Bold" VerticalAlignment="Center" MinWidth="86"
                                   Foreground="{Binding Pace.Delta, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,16,0">
                            <TextBlock Text="{Binding Pace.Spm}" FontSize="15" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Pace.Target}" FontSize="12" Foreground="{StaticResource Muted}"/>
                                <TextBlock Text="{Binding Pace.Percentile}" FontSize="12" Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="Sparkline" VerticalAlignment="Center"
                                    Visibility="{Binding Pace.HasSparkline, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                            <Canvas Width="240" Height="26"
                                    ToolTip="Your pace against the curve over the last ten minutes; the middle line is on pace, the edges ±25%. The thin lines are two enemies (your lane opponents first) against the same curve; they end where the broadcast is, about half a minute back">
                                <Line X1="0" Y1="13" X2="240" Y2="13" Stroke="#506A7880" StrokeThickness="1" StrokeDashArray="3 3"/>
                                <ItemsControl x:Name="RivalLines" ItemsSource="{Binding Pace.Rivals}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RivalLine}">
                                            <Polyline Points="{Binding Points}" StrokeThickness="1.5" StrokeLineJoin="Round" Opacity="0.9"
                                                      Stroke="{Binding Index, Converter={x:Static vm:Converters.RivalBrush}}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Polyline Points="{Binding Pace.Sparkline}" StrokeThickness="2" StrokeLineJoin="Round"
                                          Stroke="{Binding Pace.Delta, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                            </Canvas>
                            <ItemsControl x:Name="RivalLegend" ItemsSource="{Binding Pace.Rivals}" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RivalLine}">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                                                    Visibility="{Binding Visible, Converter={x:Static vm:Converters.VisibleIfTrue}}"
                                                    ToolTip="Their souls against yours at the same game time">
                                            <Border Width="10" Height="2" Background="{Binding Index, Converter={x:Static vm:Converters.RivalBrush}}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{Binding Index, Converter={x:Static vm:Converters.RivalBrush}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding Pace.PersonalLine}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{Binding Pace.PersonalDelta, Converter={x:Static vm:Converters.DeltaBrush}}"
                               Visibility="{Binding Pace.PersonalLine, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding Pace.GoalLine}" FontSize="12" Margin="0,2,0,0"
                               Foreground="{Binding Pace.GoalDelta, Converter={x:Static vm:Converters.DeltaBrush}}"
                               ToolTip="The average pace of the rank above yours on this hero, over the same window: the gate to push past"
                               Visibility="{Binding Pace.GoalLine, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <ItemsControl ItemsSource="{Binding Pace.PhaseSlots}" Margin="0,4,0,0"
                                  Visibility="{Binding Pace.HasPhases, Converter={x:Static vm:Converters.VisibleIfTrue}}"
                                  ToolTip="Your souls in each phase so far against the goal rank's on this hero; the current phase is gold">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:LivePhaseSlot}">
                                <Border CornerRadius="9" Padding="7,1" Margin="0,0,5,0" BorderThickness="1" Background="#40000000"
                                        Visibility="{Binding Visible, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#38FFFFFF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Current}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11">
                                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold">
                                            <Run.Style>
                                                <Style TargetType="Run">
                                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Current}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Run.Style>
                                        </Run><Run Text=" "/><Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{Binding Delta, Mode=OneWay, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Pace.CatchUp}" FontSize="11.5" Foreground="{StaticResource Amber}" Margin="0,2,0,0"
                               Visibility="{Binding Pace.CatchUp, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                </StackPanel>
            </Border>
            <Border x:Name="StatusPanel" Style="{StaticResource Pill}" HorizontalAlignment="Center" Margin="0,6,0,0"
                    Visibility="{Binding Pace.HasData, Converter={x:Static vm:Converters.CollapsedIfTrue}}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Gold}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{Binding Status.Phase}" FontSize="12" Foreground="{StaticResource Fg}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right of the pace strip, left of the spectator panel and death recap (x 1230-1560), down to the minimap (y 168-628) -->
        <StackPanel x:Name="RightColumn" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,168,360,0" Width="330" MaxHeight="460" ClipToBounds="True">
            <!-- Enemy pace board -->
            <Border x:Name="EnemyPanel" Style="{StaticResource Panel}" HorizontalAlignment="Right" Margin="0,0,0,8"
                    Visibility="{Binding EnemyPace.Rows.Count, Converter={x:Static vm:Converters.VisibleIfPositive}}">
                <StackPanel>
                    <TextBlock Text="{Binding EnemyPace.Title}" Style="{StaticResource Caption}"/>
                    <ItemsControl ItemsSource="{Binding EnemyPace.Rows}" ItemTemplate="{StaticResource EnemyRow}"/>
                </StackPanel>
            </Border>
            <!-- Objectives: mid boss, Rejuvenators, urn (Direct feed). Game-clock times, so the broadcast delay does not shift them. -->
            <Border x:Name="ObjectivesPanel" Style="{StaticResource Panel}" HorizontalAlignment="Right" Margin="0,0,0,8" Visibility="Collapsed"
                    ToolTip="From the broadcast: when the mid boss died and the urn moved, by the game clock. The countdowns run on the live clock and turn gold 30 s before; the mid boss's return and the urn schedule are estimates.">
                <StackPanel>
                    <TextBlock Text="Objectives" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding Objectives.MidBoss}" FontSize="13"
                               Visibility="{Binding Objectives.MidBoss, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding Objectives.MidBossCountdown}" FontSize="13" FontWeight="SemiBold"
                               Visibility="{Binding Objectives.MidBossCountdown, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Objectives.MidBossSoon}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding Objectives.Rejuvs}" FontSize="12" Foreground="{StaticResource Muted}"
                               Visibility="{Binding Objectives.Rejuvs, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding Objectives.Urn}" FontSize="13" Foreground="{StaticResource Gold}"
                               Visibility="{Binding Objectives.Urn, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding Objectives.UrnCountdown}" FontSize="13" FontWeight="SemiBold"
                               Visibility="{Binding Objectives.UrnCountdown, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Objectives.UrnSoon}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <!-- Build hint -->
            <Border x:Name="BuildPanel" Style="{StaticResource Panel}" HorizontalAlignment="Right" Margin="0,0,0,8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{Binding Build.Title}" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding Build.Items}" FontSize="13" TextWrapping="Wrap"
                               Visibility="{Binding Build.Items, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding Build.Abilities}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Gold}" Margin="0,2,0,0"
                               Visibility="{Binding Build.Abilities, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <!-- Next item: your usual next big item against the goal rank's buy time; gold inside the lead, red once late -->
                    <TextBlock Text="{Binding Build.NextItem}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"
                               ToolTip="Your usual next big item on this hero (from your recent games) and when players of the goal rank have it"
                               Visibility="{Binding Build.NextItem, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Build.NextItemState}" Value="Soon">
                                        <Setter Property="Foreground" Value="{StaticResource Gold}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Build.NextItemState}" Value="Late">
                                        <Setter Property="Foreground" Value="{StaticResource Bad}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Left column, from under the top bar down to the stats block (y 168-573); clipped there so it never covers the HUD -->
        <StackPanel x:Name="LeftColumn" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,168,0,0" MaxHeight="520" ClipToBounds="True">
            <!-- Lane card -->
            <Border x:Name="LanePanel" Style="{StaticResource Panel}" HorizontalAlignment="Left" Margin="0,0,0,8"
                    Visibility="{Binding Scout.LaneOpponents.Count, Converter={x:Static vm:Converters.VisibleIfPositive}}">
                <StackPanel>
                    <TextBlock Text="{Binding Scout.LaneTitle}" Style="{StaticResource Caption}"/>
                    <ItemsControl ItemsSource="{Binding Scout.LaneOpponents}" ItemTemplate="{StaticResource LaneRow}"/>
                </StackPanel>
            </Border>
            <!-- Scout list: Ctrl+Shift+L -->
            <!-- Laning timers: the jungle's first spawns by the live game clock, gold 30 s before each so you push your wave -->
            <Border x:Name="TimersPanel" Style="{StaticResource Panel}" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed" MinWidth="330"
                    ToolTip="Jungle first spawns. A row turns gold before its spawn: push your wave so you are free when it appears.">
                <StackPanel>
                    <TextBlock Text="Laning timers" Style="{StaticResource Caption}"/>
                    <ItemsControl ItemsSource="{Binding Timers.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TimerSlot}">
                                <Grid Margin="0,1" Visibility="{Binding Visible, Converter={x:Static vm:Converters.VisibleIfTrue}}" ToolTip="{Binding Note}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Time}" FontSize="12.5" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Names}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Border Grid.Column="2" CornerRadius="9" Padding="8,1" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#30FFFFFF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Push}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Gold}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Up}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource Good}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Countdown}" FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Push}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Up}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding Timers.ClockLine}" FontSize="10.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap" MaxWidth="330" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>
            <Border x:Name="ScoutPanel" Style="{StaticResource Panel}" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{Binding Scout.RankSpread}" Style="{StaticResource Caption}"/>
                    <ContentPresenter ContentTemplate="{StaticResource TeamHeader}" Content="{x:Static vm:TeamHeaders.Amber}"/>
                    <ItemsControl ItemsSource="{Binding Scout.Amber}" ItemTemplate="{StaticResource ScoutRow}"/>
                    <ContentPresenter ContentTemplate="{StaticResource TeamHeader}" Content="{x:Static vm:TeamHeaders.Sapphire}" Margin="0,4,0,0"/>
                    <ItemsControl ItemsSource="{Binding Scout.Sapphire}" ItemTemplate="{StaticResource ScoutRow}"/>
                </StackPanel>
            </Border>
            <!-- Session: only outside a match (hideout and menus) -->
            <Border x:Name="SessionPanel" Style="{StaticResource Panel}" HorizontalAlignment="Left" Margin="0,0,0,8" MaxWidth="760" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="TODAY" Style="{StaticResource Caption}"/>
                    <TextBlock Text="{Binding Session.Today}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Session.Nudge}" FontSize="13" Foreground="{StaticResource Amber}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Session.Nudge, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding Session.HeroPool}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Session.HeroPool, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Panels the player dragged somewhere else (overlay.positions); the rest stay in the columns above -->
        <Canvas x:Name="FreeLayer"/>

        <!-- Layout editor: only during a preview, in the empty middle of the screen -->
        <Border x:Name="EditBar" Style="{StaticResource Panel}" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,520,0,0" Padding="14,10" BorderBrush="{StaticResource Gold}" BorderThickness="2">
            <StackPanel>
                <TextBlock Text="OVERLAY PREVIEW · LAYOUT" Style="{StaticResource Caption}" Foreground="{StaticResource Gold}"/>
                <TextBlock Text="Drag any panel to move it. Each drop is saved for this screen shape." FontSize="13" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Panel size" FontSize="13" Foreground="{StaticResource Fg}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Slider x:Name="SizeSlider" Minimum="60" Maximum="160" Value="100" Width="220" SmallChange="5" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="5" ValueChanged="SizeChanged" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SizeLabel" Text="100%" FontSize="13" Foreground="{StaticResource Fg}" Width="44" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reset to default" Click="ResetLayout" Margin="0,0,8,0"
                            ToolTip="Put every panel back in the default columns for this screen shape"/>
                    <Button Content="Stop preview" Click="StopPreview" Style="{StaticResource AccentButton}" Margin="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
