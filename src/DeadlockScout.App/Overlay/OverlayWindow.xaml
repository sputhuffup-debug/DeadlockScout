<Window x:Class="DeadlockScout.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeadlockScout.App.ViewModels"
        Title="DeadlockScout overlay"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Focusable="False" IsHitTestVisible="False"
        Foreground="#F0F0F0" FontFamily="Segoe UI">
    <!-- Foreground and font on the window itself: the implicit TextBlock style below does not reach TextBlocks inside
         data templates, which would otherwise inherit the system's black text. -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#B0101418"/>
        <SolidColorBrush x:Key="Fg" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="Muted" Color="#A0B0B8"/>
        <SolidColorBrush x:Key="Amber" Color="#F2B134"/>
        <SolidColorBrush x:Key="Sapphire" Color="#5FA8F5"/>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <DataTemplate x:Key="ScoutRow" DataType="{x:Type vm:ScoutRowViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="{Binding IsMe, Converter={x:Static vm:Converters.BoldIfTrue}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Hero}" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="2" Text="{Binding GamesOnHero}"/>
                <TextBlock Grid.Column="3" Text="{Binding WinRate}"/>
                <TextBlock Grid.Column="4" Text="{Binding Rank}" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="5" Text="{Binding Met}" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="6" Text="{Binding Flag}" Foreground="{StaticResource Amber}" FontWeight="SemiBold"/>
            </Grid>
        </DataTemplate>
        <!-- The lane card: narrower than the scout row (no met-before or flag; the scout list has those) so it stays clear of the pace strip at x=660. -->
        <DataTemplate x:Key="LaneRow" DataType="{x:Type vm:ScoutRowViewModel}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="{Binding Hero}" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="2" Text="{Binding GamesOnHero}"/>
                <TextBlock Grid.Column="3" Text="{Binding WinRate}"/>
                <TextBlock Grid.Column="4" Text="{Binding Rank}" Foreground="{StaticResource Muted}"/>
                <TextBlock Grid.Column="5" Text="{Binding Matchup}" ToolTip="Your hero's lane win rate against this hero at your rank, and how many lane matchups that rests on"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!--
      Placement follows the game's HUD on a 1920x1080 reference (the window scales it to the game's height):
      portraits, timer and team souls across the top (x 336-1584, y 0-155); spectator controls and the death recap on
      the right (x 1570+, y 0-500); stats, souls and items bottom left (from y 580); abilities bottom centre (x 770-1150,
      from y 865); minimap bottom right (x 1510-1890, from y 635). Panels stack in the free space so they never overlap
      the HUD or each other: the pace strip centred under the top bar, a left column between the top bar and the stats,
      and a narrow column between the pace strip and the spectator panel. The right edge and the bottom stay clear.
    -->
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>

        <!-- Centre, under the portraits: the pace strip, and the status line while there is no pace yet -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,168,0,0">
            <Border x:Name="PacePanel" Style="{StaticResource Panel}" MinWidth="520"
                    Visibility="{Binding Pace.HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                <StackPanel>
                    <TextBlock Text="{Binding Pace.Line}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{Binding Pace.Delta, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                    <Canvas Width="240" Height="26" Margin="0,2,0,0" HorizontalAlignment="Center" x:Name="Sparkline"
                            Visibility="{Binding Pace.HasSparkline, Converter={x:Static vm:Converters.VisibleIfTrue}}"
                            ToolTip="Your pace against the curve over the last ten minutes; the middle line is on pace, the edges ±25%">
                        <Line X1="0" Y1="13" X2="240" Y2="13" Stroke="#506A7880" StrokeThickness="1" StrokeDashArray="3 3"/>
                        <Polyline Points="{Binding Pace.Sparkline}" StrokeThickness="1.5" StrokeLineJoin="Round"
                                  Stroke="{Binding Pace.Delta, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                    </Canvas>
                    <TextBlock Text="{Binding Pace.PersonalLine}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{Binding Pace.PersonalDelta, Converter={x:Static vm:Converters.DeltaBrush}}"
                               Visibility="{Binding Pace.PersonalLine, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Pace.AsOf}" FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding Pace.Provider}" FontSize="11" Foreground="{StaticResource Muted}" ToolTip="{Binding Pace.Tooltip}"/>
                        <TextBlock Text=" · " FontSize="11" Foreground="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding Pace.SourceLabel}" FontSize="11" Foreground="{StaticResource Muted}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="StatusPanel" Style="{StaticResource Panel}" HorizontalAlignment="Center" Margin="0,6,0,0"
                    Visibility="{Binding Pace.HasData, Converter={x:Static vm:Converters.CollapsedIfTrue}}">
                <TextBlock Text="{Binding Status.Phase}" FontSize="12" Foreground="{StaticResource Muted}"/>
            </Border>
        </StackPanel>

        <!-- Right of the pace strip, left of the spectator panel and death recap (x 1230-1560), down to the minimap (y 168-628) -->
        <StackPanel x:Name="RightColumn" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,168,360,0" Width="330" MaxHeight="460" ClipToBounds="True">
            <!-- Enemy pace board -->
            <Border x:Name="EnemyPanel" Style="{StaticResource Panel}" HorizontalAlignment="Right" Margin="0,0,0,8"
                    Visibility="{Binding EnemyPace.Rows.Count, Converter={x:Static vm:Converters.VisibleIfPositive}}">
                <StackPanel>
                    <TextBlock Text="{Binding EnemyPace.Title}" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <ItemsControl ItemsSource="{Binding EnemyPace.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EnemyPaceRowViewModel}">
                                <TextBlock Text="{Binding Line}" FontSize="13" Foreground="{Binding Lead, Converter={x:Static vm:Converters.LeadBrush}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <!-- Build hint -->
            <Border x:Name="BuildPanel" Style="{StaticResource Panel}" HorizontalAlignment="Right" Margin="0,0,0,8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{Binding Build.Title}" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <TextBlock Text="{Binding Build.Items}" FontSize="13" TextWrapping="Wrap"
                               Visibility="{Binding Build.Items, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding Build.Abilities}" FontSize="13" TextWrapping="Wrap"
                               Visibility="{Binding Build.Abilities, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Left column, from under the top bar down to the stats block (y 168-573); clipped there so it never covers the HUD -->
        <StackPanel x:Name="LeftColumn" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,168,0,0" MaxHeight="405" ClipToBounds="True">
            <!-- Lane card -->
            <Border x:Name="LanePanel" Style="{StaticResource Panel}" HorizontalAlignment="Left" Margin="0,0,0,8"
                    Visibility="{Binding Scout.LaneOpponents.Count, Converter={x:Static vm:Converters.VisibleIfPositive}}">
                <StackPanel>
                    <TextBlock Text="{Binding Scout.LaneTitle}" FontSize="12" Foreground="{StaticResource Muted}"/>
                    <ItemsControl ItemsSource="{Binding Scout.LaneOpponents}" ItemTemplate="{StaticResource LaneRow}"/>
                </StackPanel>
            </Border>
            <!-- Scout list: toggled, auto-shown after the roster arrives -->
            <Border x:Name="ScoutPanel" Style="{StaticResource Panel}" HorizontalAlignment="Left" Margin="0,0,0,8" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{Binding Scout.RankSpread}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                    <TextBlock Text="Amber" Foreground="{StaticResource Amber}" FontWeight="SemiBold"/>
                    <ItemsControl ItemsSource="{Binding Scout.Amber}" ItemTemplate="{StaticResource ScoutRow}"/>
                    <TextBlock Text="Sapphire" Foreground="{StaticResource Sapphire}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                    <ItemsControl ItemsSource="{Binding Scout.Sapphire}" ItemTemplate="{StaticResource ScoutRow}"/>
                </StackPanel>
            </Border>
            <!-- Session: only outside a match (hideout and menus) -->
            <Border x:Name="SessionPanel" Style="{StaticResource Panel}" HorizontalAlignment="Left" Margin="0,0,0,8" MaxWidth="760" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{Binding Session.Today}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Session.Nudge}" FontSize="13" Foreground="{StaticResource Amber}" TextWrapping="Wrap"
                               Visibility="{Binding Session.Nudge, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding Session.HeroPool}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Visibility="{Binding Session.HeroPool, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
