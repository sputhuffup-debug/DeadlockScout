<!--
  DeadlockScout's look, shared by the main window and the overlay: dark surfaces, one gold accent (the souls colour),
  the two team colours, and green/red only for ahead/behind. Keys keep the names the windows already use.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DeadlockScout.App.ViewModels">
    <Color x:Key="BgColor">#12161B</Color>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Surface" Color="#1A2027"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#232B34"/>
    <!-- Overlay cards: dark enough to read over a bright map, still see-through. -->
    <SolidColorBrush x:Key="PanelBg" Color="#D80E1217"/>
    <SolidColorBrush x:Key="Line" Color="#2A333D"/>
    <SolidColorBrush x:Key="OverlayLine" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="Fg" Color="#E8EDF2"/>
    <SolidColorBrush x:Key="Muted" Color="#8C99A6"/>
    <SolidColorBrush x:Key="Gold" Color="#E8B04B"/>
    <SolidColorBrush x:Key="GoldSoft" Color="#33E8B04B"/>
    <SolidColorBrush x:Key="Amber" Color="#F2B134"/>
    <SolidColorBrush x:Key="Sapphire" Color="#5FA8F5"/>
    <SolidColorBrush x:Key="Good" Color="#7FE08A"/>
    <SolidColorBrush x:Key="Bad" Color="#F07A6E"/>
    <SolidColorBrush x:Key="ChipBg" Color="#33F2B134"/>

    <!-- Main window card -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Overlay card -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OverlayLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- Small section heading: "LANE 1 OPPONENTS", "ENEMY PACE" -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- A flag such as "Smurf?" or "new on hero" -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChipBg}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Status pill with a gold dot -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OverlayLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <!-- Flat buttons for the main window -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The one action that matters most in the row gets the accent. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource GoldSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>

    <!--
      Scroll bars: no arrows, a slim rounded thumb on a clear track that widens and warms to gold under the mouse.
      Implicit, so every ScrollViewer in the app picks it up.
    -->
    <SolidColorBrush x:Key="ThumbIdle" Color="#3A4652"/>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Grip" Background="{StaticResource ThumbIdle}" CornerRadius="3"/>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="#6B5A3A"/>
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{StaticResource Gold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="2,4">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Style="{StaticResource ScrollThumb}" Width="4" MinHeight="28" HorizontalAlignment="Center"/>
                            </Track.Thumb>
                        </Track>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#14FFFFFF"/>
                            <Setter TargetName="Thumb" Property="Width" Value="7"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="4,2">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb" Style="{StaticResource ScrollThumb}" Height="4" MinWidth="28" VerticalAlignment="Center"/>
                                    </Track.Thumb>
                                </Track>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#14FFFFFF"/>
                                    <Setter TargetName="Thumb" Property="Height" Value="7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      The app's own window frame (main window, match history): WindowChrome takes over the title bar, so Windows' white
      caption is gone but snapping, resizing, double-click to maximise and the system menu still work. A dark bar with the
      icon, "Deadlock" + gold "Scout" and the rest of the title muted, a gold rule fading out under it, and flat caption
      buttons (close turns red). Interop/WindowFrame wires the buttons and asks Windows for a dark border.
    -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                            <Setter TargetName="Glyph" Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#9E2316"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <LinearGradientBrush x:Key="TitleBarBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B222A" Offset="0"/>
        <GradientStop Color="#141A20" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleRule" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00E8B04B" Offset="0"/>
        <GradientStop Color="#C0E8B04B" Offset="0.08"/>
        <GradientStop Color="#40E8B04B" Offset="0.45"/>
        <GradientStop Color="#00E8B04B" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="ScoutWindow" TargetType="Window">
        <Setter Property="Background" Value="{StaticResource Bg}"/>
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <!-- A sliver of glass at the bottom keeps the system drop shadow; the opaque frame covers it. -->
                <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource TitleBarBg}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{TemplateBinding Icon}" Width="18" Height="18" Margin="12,0,10,0" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis">
                                        <Run Text="Deadlock" FontWeight="SemiBold" Foreground="{StaticResource Fg}"/><Run
                                             Text="Scout" FontWeight="SemiBold" Foreground="{StaticResource Gold}"/><Run
                                             Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Converter={x:Static vm:Converters.TitleSuffix}}"
                                             Foreground="{StaticResource Muted}"/>
                                    </TextBlock>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button x:Name="MinButton" Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimise"
                                                Command="{x:Static SystemCommands.MinimizeWindowCommand}"/>
                                        <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximise"
                                                Command="{x:Static SystemCommands.MaximizeWindowCommand}"/>
                                        <Button x:Name="RestoreButton" Style="{StaticResource CaptionButton}" Content="&#xE923;" ToolTip="Restore"
                                                Command="{x:Static SystemCommands.RestoreWindowCommand}" Visibility="Collapsed"/>
                                        <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Close"
                                                Command="{x:Static SystemCommands.CloseWindowCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Rectangle x:Name="Rule" Height="1" VerticalAlignment="Bottom" Fill="{StaticResource TitleRule}"/>
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="False">
                            <Setter TargetName="TitleText" Property="Opacity" Value="0.55"/>
                            <Setter TargetName="Rule" Property="Opacity" Value="0.35"/>
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <!-- WindowFrame pulls the frame back in from the screen edge a maximised chrome window hangs over. -->
                            <Setter TargetName="Frame" Property="BorderThickness" Value="0"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="RestoreButton" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="CanMinimize">
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="MinButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="MaxButton" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The power-spike chip on an enemy pace row (overlay and main window): an EnemyPaceRowViewModel's latest spike item,
      coloured by kind (red ultimate, orange weapon, blue spirit, green vitality); filled and "just got ..." for half a
      minute after the purchase, then a quiet chip. The item's icon, or its initial in a small square until the icon
      loads (and in screenshots: no game art).
    -->
    <DataTemplate x:Key="SpikeChip">
        <Border>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource Chip}">
                    <Setter Property="Background" Value="{Binding SpikeFill}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SpikeFlash}" Value="True">
                            <Setter Property="Background" Value="{Binding SpikeColor}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Grid Width="16" Height="16" Margin="-2,1,5,1" VerticalAlignment="Center">
                    <Image Source="{Binding SpikeIcon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding SpikeIcon, Converter={x:Static vm:Converters.VisibleIfNotNull}}"/>
                    <Border CornerRadius="3" BorderThickness="1" Visibility="{Binding SpikeIcon, Converter={x:Static vm:Converters.CollapsedIfNotNull}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{Binding SpikeColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SpikeFlash}" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Bg}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding SpikeInitial}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=Border}}"/>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding SpikeText}" FontSize="12" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding SpikeColor}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SpikeFlash}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Bg}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
