<!--
  DeadlockScout's look, shared by the main window and the overlay: dark surfaces, one gold accent (the souls colour),
  the two team colours, and green/red only for ahead/behind. Keys keep the names the windows already use.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BgColor">#12161B</Color>
    <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}"/>
    <SolidColorBrush x:Key="Surface" Color="#1A2027"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="#232B34"/>
    <!-- Overlay cards: dark enough to read over a bright map, still see-through. -->
    <SolidColorBrush x:Key="PanelBg" Color="#D80E1217"/>
    <SolidColorBrush x:Key="Line" Color="#2A333D"/>
    <SolidColorBrush x:Key="OverlayLine" Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="Fg" Color="#E8EDF2"/>
    <SolidColorBrush x:Key="Muted" Color="#8C99A6"/>
    <SolidColorBrush x:Key="Gold" Color="#E8B04B"/>
    <SolidColorBrush x:Key="GoldSoft" Color="#33E8B04B"/>
    <SolidColorBrush x:Key="Amber" Color="#F2B134"/>
    <SolidColorBrush x:Key="Sapphire" Color="#5FA8F5"/>
    <SolidColorBrush x:Key="Good" Color="#7FE08A"/>
    <SolidColorBrush x:Key="Bad" Color="#F07A6E"/>
    <SolidColorBrush x:Key="ChipBg" Color="#33F2B134"/>

    <!-- Main window card -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Overlay card -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OverlayLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,6"/>
    </Style>

    <!-- Small section heading: "LANE 1 OPPONENTS", "ENEMY PACE" -->
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        <Setter Property="Margin" Value="0,0,0,3"/>
    </Style>

    <!-- A flag such as "Smurf?" or "new on hero" -->
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ChipBg}"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Status pill with a gold dot -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OverlayLine}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <!-- Flat buttons for the main window -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- The one action that matters most in the row gets the accent. -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource GoldSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,14,0"/>
    </Style>
</ResourceDictionary>
