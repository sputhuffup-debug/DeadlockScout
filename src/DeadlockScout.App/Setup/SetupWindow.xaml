<Window x:Class="DeadlockScout.App.Setup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:setup="clr-namespace:DeadlockScout.App.Setup"
        Title="DeadlockScout · Setup" Icon="pack://application:,,,/Assets/app.ico" Width="860" Height="620"
        Style="{StaticResource ScoutWindow}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="Para" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="LineHeight" Value="20"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="Root" Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <!-- The steps, each with how it stands -->
        <ItemsControl ItemsSource="{Binding Steps}" Margin="0,4,18,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type setup:SetupStepItem}">
                    <Border x:Name="Bd" CornerRadius="6" Padding="10,7" Margin="0,0,0,4" Background="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Mark}" Foreground="{Binding MarkBrush}" FontWeight="Bold" Width="18"/>
                            <TextBlock x:Name="Name" Text="{Binding Title}"/>
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Current}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldSoft}"/>
                            <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Gold}"/>
                            <Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="24,20" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                <StackPanel x:Name="Page0">
                    <TextBlock Text="Welcome to DeadlockScout" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock Text="DeadlockScout watches for your Deadlock match, scouts the lobby, and draws an overlay with your souls per minute against the rank you are pushing towards, plus timers, objectives and enemy power spikes." Style="{StaticResource Para}"/>
                    <TextBlock Text="It never touches the game: it only reads files the game and Steam write on purpose, draws its own transparent window on top, and uses public match data from deadlock-api.com. No memory reading, no injection, no input." Style="{StaticResource Para}"/>
                    <TextBlock Text="This takes about a minute: find Steam and your account, turn on match detection, check the game's display mode, and (optionally) set up OCR." Style="{StaticResource Para}"/>
                </StackPanel>
                <StackPanel x:Name="Page1" Visibility="Collapsed">
                    <TextBlock Text="Steam and account" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="#161C22" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,14">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding SteamBrush}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                <TextBlock Text="{Binding SteamCheck.Detail}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                    <TextBlock Text="Steam folder (where steam.exe is)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding SteamInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="Deadlock folder (leave blank to find it in Steam's libraries)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding DeadlockInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="Steam account id (blank: the account last signed in to Steam)" Style="{StaticResource Label}"/>
                    <TextBox Text="{Binding AccountInput, UpdateSourceTrigger=PropertyChanged}" Width="200" HorizontalAlignment="Left" Margin="0,0,0,12"/>
                    <Button Content="Save and check again" Click="ApplyPaths" HorizontalAlignment="Left" Style="{StaticResource AccentButton}"/>
                </StackPanel>
                <StackPanel x:Name="Page2" Visibility="Collapsed">
                    <TextBlock Text="Match detection" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="#161C22" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,14">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding CondebugBrush}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                <TextBlock Text="{Binding CondebugCheck.Detail}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                    <TextBlock Text="Deadlock writes a console log only when it starts with the -condebug launch option. The app reads that log to see a match start and end; nothing else is needed." Style="{StaticResource Para}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                        <Button Content="Add -condebug" Click="AddCondebug" Style="{StaticResource AccentButton}"/>
                        <Button Content="Check again" Click="Recheck"/>
                    </StackPanel>
                    <TextBlock Text="{Binding CondebugResult}" Foreground="{StaticResource Amber}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="Page3" Visibility="Collapsed">
                    <TextBlock Text="Display mode" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="#161C22" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,14">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding DisplayBrush}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                <TextBlock Text="{Binding DisplayCheck.Detail}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                    <TextBlock Text="The overlay is an ordinary window on top of the game, so Deadlock has to run borderless (fullscreen windowed) or in a window. Exclusive fullscreen hides every other window, and the app will not work around that." Style="{StaticResource Para}"/>
                    <TextBlock Style="{StaticResource Para}"><Run Text="Read from "/><Run Text="{Binding VideoConfigPath, Mode=OneWay}" Foreground="{StaticResource Muted}"/><Run Text=". The app never changes the game's settings."/></TextBlock>
                    <Button Content="Check again" Click="Recheck" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel x:Name="Page4" Visibility="Collapsed">
                    <TextBlock Text="OCR (optional)" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Border Background="#161C22" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,4,0,14">
                            <DockPanel>
                                <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding OcrBrush}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                                <TextBlock Text="{Binding OcrCheck.Detail}" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                    <TextBlock Text="By default your souls come from the public broadcast, 30–60 s late. With OCR on, the app reads your soul count and the match clock off the screen once a second: real time, and the timers use the exact clock. Only the boxes you draw are ever captured." Style="{StaticResource Para}"/>
                    <CheckBox IsChecked="{Binding OcrEnabled}" Content="Use OCR for souls and the clock" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                    <Button Content="Calibrate now (with the game running)" Click="Calibrate" HorizontalAlignment="Left"/>
                </StackPanel>
                <StackPanel x:Name="Page5" Visibility="Collapsed">
                    <TextBlock Text="Try it" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <DockPanel Margin="0,0,0,8">
                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding SteamBrush}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding SteamCheck.Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding SteamCheck.Detail, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding CondebugBrush}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding CondebugCheck.Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding CondebugCheck.Detail, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding DisplayBrush}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding DisplayCheck.Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding DisplayCheck.Detail, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                        <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Fill="{Binding OcrBrush}" VerticalAlignment="Top" Margin="0,5,10,0"/>
                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding OcrCheck.Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding OcrCheck.Detail, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                    </DockPanel>
                    <Button Content="Show the demo lobby on the overlay" Click="Preview" HorizontalAlignment="Left" Style="{StaticResource AccentButton}" Margin="0,8,0,10"/>
                    <TextBlock Text="Panels can be dragged while the preview is on. Settings has everything else, and the tray menu brings this wizard back." Style="{StaticResource Para}"/>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Button Content="Skip setup" Click="Skip" HorizontalAlignment="Left" Margin="0"
                    ToolTip="Close the wizard and do not show it at start-up again; the tray menu brings it back."/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Click="Back" Margin="0,0,8,0"/>
                <Button x:Name="NextButton" Content="Next" Click="Next" Style="{StaticResource AccentButton}" Margin="0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
