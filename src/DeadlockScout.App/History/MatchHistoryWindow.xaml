<Window x:Class="DeadlockScout.App.History.MatchHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeadlockScout.App.ViewModels"
        xmlns:c="clr-namespace:DeadlockScout.App.Controls"
        Title="DeadlockScout · Match history" Icon="pack://application:,,,/Assets/app.ico" Width="1140" Height="880"
        Style="{StaticResource ScoutWindow}">
    <!-- Colours, cards, captions and buttons come from Themes/Theme.xaml. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Big" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- A row of choices as pills (range, hero): the selected one in the accent -->
        <Style x:Key="PillList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <!-- No ScrollViewer inside, so the mouse wheel still scrolls the window over the pills -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            CornerRadius="12" Padding="10,3" Margin="0,0,6,6">
                                        <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Fg}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GoldSoft}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Gold}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- An item as a square: its icon, or its initial on its slot's colour until the icon loads (and in screenshots: no game art) -->
        <DataTemplate x:Key="ItemSquare" DataType="{x:Type vm:ItemChipViewModel}">
            <Grid ToolTip="{Binding Name}">
                <Border CornerRadius="3" BorderThickness="1" Background="{Binding Fill}" BorderBrush="{Binding Color}"
                        Visibility="{Binding Icon, Converter={x:Static vm:Converters.CollapsedIfNotNull}}">
                    <TextBlock Text="{Binding Initial}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image Source="{Binding Icon}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding Icon, Converter={x:Static vm:Converters.VisibleIfNotNull}}"/>
            </Grid>
        </DataTemplate>
        <!-- A hero as a square: portrait once loaded, initial until then -->
        <DataTemplate x:Key="HeroSquare" DataType="{x:Type vm:IconViewModel}">
            <Grid>
                <Border CornerRadius="6" BorderThickness="1" Background="{StaticResource SurfaceHover}" BorderBrush="{StaticResource Line}"
                        Visibility="{Binding Icon, Converter={x:Static vm:Converters.CollapsedIfNotNull}}">
                    <Viewbox Margin="6"><TextBlock Text="{Binding Initial}" Foreground="{StaticResource Muted}" FontWeight="Bold"/></Viewbox>
                </Border>
                <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding Icon, Converter={x:Static vm:Converters.VisibleIfNotNull}}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="PlayerLine" DataType="{x:Type vm:PlayerLineViewModel}">
            <Grid Margin="0,0,0,1" ToolTip="{Binding Souls}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Hero}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                           FontWeight="{Binding IsMe, Converter={x:Static vm:Converters.BoldIfTrue}}"/>
                <TextBlock Grid.Column="1" Text="{Binding Kda}" FontSize="11.5" Foreground="{StaticResource Muted}"/>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="Purchase" DataType="{x:Type vm:PurchaseViewModel}">
            <Border Style="{StaticResource Chip}" Margin="0,0,6,6" Padding="6,3">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TimeText}" Style="{StaticResource MutedText}" Width="34" VerticalAlignment="Center"/>
                    <ContentPresenter Content="{Binding Chip}" ContentTemplate="{StaticResource ItemSquare}" Width="18" Height="18" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Chip.Name}" FontSize="12" Foreground="{Binding Chip.Color}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SoldText}" Style="{StaticResource MutedText}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding SoldText, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                    <TextBlock Text="{Binding RankText}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Gap, Converter={x:Static vm:Converters.TimingBrush}}"
                               Visibility="{Binding RankText, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GameCard" DataType="{x:Type vm:GameCardViewModel}">
            <Border Style="{StaticResource Card}" Padding="0" Cursor="Hand" MouseLeftButtonUp="ToggleCard">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding Edge}" CornerRadius="8,0,0,8"/>
                    <StackPanel Grid.Column="1" Margin="14,10,14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="104"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="168"/>
                                <ColumnDefinition Width="164"/>
                                <ColumnDefinition Width="146"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ResultText}" Foreground="{Binding Edge}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding TimeAgo}" Style="{StaticResource MutedText}" Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding DurationText}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                <ContentPresenter Content="{Binding Hero}" ContentTemplate="{StaticResource HeroSquare}" Width="44" Height="44"/>
                                <StackPanel Margin="10,2,0,0">
                                    <TextBlock Text="{Binding Hero.Name}" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource MutedText}" Visibility="{Binding LevelText, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}">
                                        <Run Text="level"/> <Run Text="{Binding LevelText, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="16" FontWeight="SemiBold">
                                    <Run Text="{Binding KdaLine, Mode=OneWay}"/><Run Text="  "/><Run
                                         Text="{Binding SoulsShort, Mode=OneWay}" Foreground="{StaticResource Gold}"/><Run
                                         Text=" souls" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Muted}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding KdaRatio}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <ItemsControl Grid.Column="3" ItemsSource="{Binding Items}" VerticalAlignment="Top">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Width="156"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ItemSquare}" Width="22" Height="22" Margin="0,0,4,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Grid.Column="4">
                                <TextBlock FontSize="12.5"><Run Text="{Binding SoulsText, Mode=OneWay}" FontWeight="SemiBold"/> <Run Text="{Binding SpmText, Mode=OneWay}" Foreground="{StaticResource Muted}"/></TextBlock>
                                <TextBlock Text="{Binding LastHitsText}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding TeamRankText}" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding BadgeText}" Style="{StaticResource MutedText}"/>
                            </StackPanel>
                            <Grid Grid.Column="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding Team}" ItemTemplate="{StaticResource PlayerLine}" Margin="0,0,8,0"/>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Enemies}" ItemTemplate="{StaticResource PlayerLine}"/>
                            </Grid>
                        </Grid>
                        <TextBlock Text="Items, teams and the timeline appear once the API has processed this match (usually a few minutes after it ends)."
                                   Style="{StaticResource MutedText}" Margin="0,6,0,0"
                                   Visibility="{Binding Pending, Converter={x:Static vm:Converters.VisibleIfTrue}}"/>
                        <!-- Timelines, for the opened card: souls through the match with each purchase on the line, then the purchases in order -->
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsExpanded}" Value="True"/>
                                                <Condition Binding="{Binding HasTimeline}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <!-- The rank gate picker; clicks on it never open or close the card -->
                            <Grid MouseLeftButtonUp="KeepCard" Background="Transparent" Cursor="Arrow">
                                <TextBlock Text="SOUL TIMELINE" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Rank gate" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox Width="130" FontSize="12"
                                              ItemsSource="{Binding DataContext.GoalChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding DataContext.Goal, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                                              ToolTip="Draw the average souls of a rank on this hero over your own: the gate to push past">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Text}" FontSize="12"/></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Margin="12,0,0,0" ToolTip="List Initiate and Seeker too (the overlay's goal can then be one of them)"
                                              IsChecked="{Binding DataContext.IncludeLowRanks, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}">
                                        <TextBlock Text="Initiate &amp; Seeker" FontSize="12"/>
                                    </CheckBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding GoalText}" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{Binding GoalDelta, Converter={x:Static vm:Converters.DeltaBrush}}"
                                       Visibility="{Binding GoalText, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                            <!-- This game's phases against the gate -->
                            <ItemsControl ItemsSource="{Binding PhaseChips}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:PhaseChipViewModel}">
                                        <Border Background="#161C22" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10"
                                                Padding="9,2" Margin="0,0,6,0" ToolTip="{Binding Tooltip}">
                                            <TextBlock FontSize="11.5">
                                                <Run Text="{Binding Label, Mode=OneWay}" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/><Run Text="  "/><Run
                                                     Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold"
                                                     Foreground="{Binding Delta, Mode=OneWay, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <c:SoulTimeline Souls="{Binding Souls}" Markers="{Binding Markers}" Duration="{Binding Duration}" Height="210" Margin="0,2,0,8"
                                            Expected="{Binding Expected}" ExpectedLabel="{Binding ExpectedLabel}"/>
                            <TextBlock Text="ITEM PURCHASES" Style="{StaticResource Caption}"/>
                            <TextBlock Text="{Binding ItemTimingText}" FontSize="12" Margin="0,0,0,2"
                                       Foreground="{Binding ItemTimingGap, Converter={x:Static vm:Converters.TimingBrush}}"
                                       Visibility="{Binding ItemTimingText, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}"/>
                            <ItemsControl ItemsSource="{Binding Purchases}" ItemTemplate="{StaticResource Purchase}" Margin="0,4,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="16,12">
        <StackPanel x:Name="Header" DockPanel.Dock="Top">
            <Grid Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Match history" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh" HorizontalAlignment="Right" Margin="0"/>
            </Grid>
            <!-- Summary over the recent games -->
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="RANK" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Rank}" Style="{StaticResource Big}" Foreground="{StaticResource Gold}"/>
                        <TextBlock Text="{Binding RankLine}" Style="{StaticResource MutedText}"/>
                        <Polyline Points="{Binding RankPoints}" Stroke="{StaticResource Gold}" StrokeThickness="2" Width="160" Height="36"
                                  HorizontalAlignment="Left" Margin="0,6,0,0" StrokeLineJoin="Round"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="WIN RATE" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding WinRate}" Style="{StaticResource Big}"/>
                        <TextBlock Text="{Binding Record}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="KDA" Style="{StaticResource Caption}"/>
                        <TextBlock Text="{Binding Kda}" Style="{StaticResource Big}"/>
                        <TextBlock Text="{Binding KdaLine}" Style="{StaticResource MutedText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="MAIN HEROES" Style="{StaticResource Caption}"/>
                        <ItemsControl ItemsSource="{Binding MainHeroes}" Margin="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HeroUsageViewModel}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HeroSquare}" Width="24" Height="24"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Line}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="LAST 15" Style="{StaticResource Caption}"/>
                        <ItemsControl ItemsSource="{Binding LastResults}" Margin="0,6,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><Border Width="9" Height="24" CornerRadius="2" Margin="0,0,3,0" Background="{Binding}"/></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="newest first" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body">
                <!-- Trends over the history rows: range and hero, rolling win rate and souls per minute, then vs now, per hero -->
                <Border Style="{StaticResource Card}" Padding="16,12" DataContext="{Binding Trends}"
                        Visibility="{Binding HasData, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <ListBox Style="{StaticResource PillList}" ItemsSource="{Binding Ranges}" SelectedItem="{Binding Range}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ListBox Style="{StaticResource PillList}" ItemsSource="{Binding HeroChoices}" SelectedItem="{Binding Hero}" Margin="0,4,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="WIN RATE · ROLLING 10 GAMES" Style="{StaticResource Caption}"/>
                                <c:TrendChart Kind="WinRate" Points="{Binding Points}" Labels="{Binding Labels}" Height="130"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SOULS PER MINUTE · EACH GAME, ROLLING 10" Style="{StaticResource Caption}"/>
                                <c:TrendChart Kind="SoulsPerMinute" Points="{Binding Points}" Labels="{Binding Labels}" Height="130"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,10"
                                    Visibility="{Binding SpmChange, Converter={x:Static vm:Converters.VisibleIfNotEmpty}}">
                            <TextBlock Text="Older half → newer half:" Style="{StaticResource MutedText}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding WinRateChange}" Foreground="{Binding WinRateBrush}" FontWeight="SemiBold" Margin="0,0,18,0"/>
                            <TextBlock Text="{Binding SpmChange}" Foreground="{Binding SpmBrush}" FontWeight="SemiBold" Margin="0,0,18,0"/>
                            <TextBlock Text="{Binding KdaChange}" Foreground="{Binding KdaBrush}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="210"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HERO" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="1" Text="GAMES" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="2" Text="W–L" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="3" Text="WIN RATE" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="4" Text="KDA" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="5" Text="SOULS/MIN" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="6" Text="LAST PLAYED" Style="{StaticResource Caption}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Heroes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HeroTrendRowViewModel}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource HeroSquare}" Width="22" Height="22"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Games}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Record}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding WinRate}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Kda}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Spm}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding LastPlayed}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- Laning, mid and late game over the page's games against the rank gate: which phase costs the most -->
                <Border Style="{StaticResource Card}" Padding="16,12"
                        Visibility="{Binding HasPhases, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding PhaseTitle}" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Rank gate" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="130" FontSize="12" ItemsSource="{Binding GoalChoices}" SelectedItem="{Binding Goal, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Text}" FontSize="12"/></DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PhaseCards}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PhaseCardViewModel}">
                                    <Border CornerRadius="8" Padding="12,8" Margin="0,0,10,0" Background="#161C22" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsWeakest}" Value="True">
                                                        <Setter Property="BorderBrush" Value="{StaticResource Gold}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding Name, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Span, Mode=OneWay}" FontWeight="Normal"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding DeltaText}" Style="{StaticResource Big}"
                                                       Foreground="{Binding Delta, Converter={x:Static vm:Converters.DeltaBrush}}"/>
                                            <TextBlock Text="{Binding Rates}" Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="{Binding Souls}" Style="{StaticResource MutedText}"/>
                                            <TextBlock Text="{Binding Games}" Style="{StaticResource MutedText}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding PhaseVerdict}" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <!-- The items you buy most, your average buy time against the rank's -->
                <Border Style="{StaticResource Card}" Padding="16,12"
                        Visibility="{Binding HasTimings, Converter={x:Static vm:Converters.VisibleIfTrue}}">
                    <StackPanel>
                        <TextBlock Text="{Binding TimingTitle}" Style="{StaticResource Caption}"/>
                        <Grid Margin="0,6,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ITEM" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="1" Text="GAMES" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="2" Text="YOU" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="3" Text="RANK" Style="{StaticResource Caption}"/>
                            <TextBlock Grid.Column="4" Text="GAP" Style="{StaticResource Caption}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TimingRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ItemTimingRowViewModel}">
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal">
                                            <ContentPresenter Content="{Binding Chip}" ContentTemplate="{StaticResource ItemSquare}" Width="20" Height="20"/>
                                            <TextBlock Text="{Binding Chip.Name}" Foreground="{Binding Chip.Color}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Games}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding You}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Rank}" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding GapText}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Gap, Converter={x:Static vm:Converters.TimingBrush}}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding TimingVerdict}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding GamesTitle}" Style="{StaticResource Caption}" Margin="2,4,0,6"/>
                <ItemsControl ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCard}"/>
                <TextBlock Text="Click a game to open its soul timeline and item purchases." Style="{StaticResource MutedText}" Margin="2,0,0,8"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
