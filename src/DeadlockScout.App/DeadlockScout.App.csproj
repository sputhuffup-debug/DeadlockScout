<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DeadlockScout.App</RootNamespace>
    <AssemblyName>DeadlockScout</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeadlockScout.Core\DeadlockScout.Core.csproj" />
    <ProjectReference Include="..\DeadlockScout.Steam\DeadlockScout.Steam.csproj" />
    <ProjectReference Include="..\DeadlockScout.Api\DeadlockScout.Api.csproj" />
    <ProjectReference Include="..\DeadlockScout.Ocr\DeadlockScout.Ocr.csproj" />
  </ItemGroup>

</Project>
