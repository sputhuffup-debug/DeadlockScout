<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DeadlockScout.App</RootNamespace>
    <AssemblyName>DeadlockScout</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StartupObject>DeadlockScout.App.Program</StartupObject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WinForms is only here for NotifyIcon; keep its implicit usings out so System.Drawing never shadows WPF types. -->
    <DisableImplicitNamespaceImports_WindowsForms>true</DisableImplicitNamespaceImports_WindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeadlockScout.Core\DeadlockScout.Core.csproj" />
    <ProjectReference Include="..\DeadlockScout.Steam\DeadlockScout.Steam.csproj" />
    <ProjectReference Include="..\DeadlockScout.Api\DeadlockScout.Api.csproj" />
    <ProjectReference Include="..\DeadlockScout.Ocr\DeadlockScout.Ocr.csproj" />
  </ItemGroup>

</Project>
